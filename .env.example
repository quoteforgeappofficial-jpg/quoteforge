# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and must never be committed.

# --- Supabase ---
# Project URL and anon (public) key — safe for use in browser code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-side only. Bypasses Row Level Security.
# Never expose this to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Public base URL of this deployment (e.g. http://localhost:3000 in dev).
# Used to build auth email links (signup confirmation, password reset).
NEXT_PUBLIC_SITE_URL=
